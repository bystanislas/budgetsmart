{
  "name": "budget-smart",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "description": "Budget Smart — by APEX AFRICA. Budget général, mariage, immobilier & terrain, business. Multi-devises, hors ligne, synchronisé.",
  "author": "APEX AFRICA",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "mobile:install": "npm i -D @capacitor/cli@6 && npm i @capacitor/core@6 @capacitor/android@6 @capacitor/ios@6",
    "mobile:add": "npx cap add android && npx cap add ios",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "logo": "python3 tools/budget-smart/build_logo.py",
    "workbook": "python3 tools/budget-smart/build_budget_smart.py"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^11.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
